<Window x:Class="shiftUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shiftUI"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Title="ShiftUI"
        Height="500"
        Width="800"
        MinHeight="300"
        MinWidth="300"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        SizeChanged="MainWindow_SizeChanged">

    <Grid>
        <!-- 主背景容器 -->
        <Border x:Name="MainBorder"
                Background="#1E1E2E"
                CornerRadius="10"
                BorderBrush="#45475A"
                BorderThickness="1">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 -->
                <Border x:Name="TitleBarBorder"
                        Grid.Row="0"
                        Height="44"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ShiftUI 标题 -->
                        <TextBlock Grid.Column="0"
                                   Text="ShiftUI"
                                   Foreground="#CDD6F4"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,6,0" />

                        <!-- === 控制面板（嵌入标题栏） === -->
                        <Border x:Name="ControlPanelBorder"
                                Grid.Column="1"
                                Background="#45475A"
                                CornerRadius="6"
                                Padding="8,5"
                                BorderBrush="#585B70"
                                BorderThickness="1"
                                MouseLeftButtonDown="ControlPanel_PreviewMouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal">
                                <!-- 穿透按钮 -->
                                <ToggleButton x:Name="ClickThroughToggle"
                                              Width="60" Height="28"
                                              Cursor="Hand"
                                              ToolTip="切换点击穿透 (Ctrl+Shift+T)"
                                              Checked="ClickThroughToggle_Checked"
                                              Unchecked="ClickThroughToggle_Unchecked">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="tglBorder"
                                                    Background="#585B70"
                                                    CornerRadius="4"
                                                    BorderBrush="#6C7086"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="tglText"
                                                           Text="🔒 穿透"
                                                           Foreground="#CDD6F4"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="tglBorder" Property="Background" Value="#A6E3A1" />
                                                    <Setter TargetName="tglBorder" Property="BorderBrush" Value="#A6E3A1" />
                                                    <Setter TargetName="tglText" Property="Text" Value="🔓 穿透" />
                                                    <Setter TargetName="tglText" Property="Foreground" Value="#1E1E2E" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tglBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                            <Border x:Name="Sep2" Width="1" Background="#585B70" Margin="8,2" />

                                <!-- Markdown 按钮 -->
                                <ToggleButton x:Name="MdToggle"
                                              Width="70" Height="28"
                                              Cursor="Hand"
                                              ToolTip="切换 Markdown 预览 (Ctrl+Shift+M)"
                                              Checked="MdToggle_Checked"
                                              Unchecked="MdToggle_Unchecked">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="mdBorder"
                                                    Background="#585B70"
                                                    CornerRadius="4"
                                                    BorderBrush="#6C7086"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="mdText"
                                                           Text="📝 MD"
                                                           Foreground="#CDD6F4"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="mdBorder" Property="Background" Value="#89B4FA" />
                                                    <Setter TargetName="mdBorder" Property="BorderBrush" Value="#89B4FA" />
                                                    <Setter TargetName="mdText" Property="Text" Value="👁 MD" />
                                                    <Setter TargetName="mdText" Property="Foreground" Value="#1E1E2E" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="mdBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                            <Border x:Name="Sep3" Width="1" Background="#585B70" Margin="8,2" />

                                <!-- 置顶按钮 -->
                                <ToggleButton x:Name="TopmostToggle"
                                              Width="60" Height="28"
                                              Cursor="Hand"
                                              IsChecked="False"
                                              ToolTip="切换窗口置顶 (Ctrl+Shift+L)"
                                              Checked="TopmostToggle_Checked"
                                              Unchecked="TopmostToggle_Unchecked">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="topBorder"
                                                    Background="#585B70"
                                                    CornerRadius="4"
                                                    BorderBrush="#6C7086"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="topText"
                                                           Text="📌 置顶"
                                                           Foreground="#CDD6F4"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="topBorder" Property="Background" Value="#585B70" />
                                                    <Setter TargetName="topBorder" Property="BorderBrush" Value="#6C7086" />
                                                    <Setter TargetName="topText" Property="Text" Value="📍 普通" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="topBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Border x:Name="Sep4" Width="1" Background="#585B70" Margin="8,2" />

                                <!-- 隐藏UI按钮 -->
                                <ToggleButton x:Name="HideUIToggle"
                                              Width="60" Height="28"
                                              Cursor="Hand"
                                              ToolTip="隐藏界面仅显示文字 (Ctrl+Shift+H)"
                                              Checked="HideUIToggle_Changed"
                                              Unchecked="HideUIToggle_Changed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="huiBorder"
                                                    Background="#585B70"
                                                    CornerRadius="4"
                                                    BorderBrush="#6C7086"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="huiText"
                                                           Text="🖼 UI"
                                                           Foreground="#CDD6F4"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="huiBorder" Property="Background" Value="#CBA6F7" />
                                                    <Setter TargetName="huiBorder" Property="BorderBrush" Value="#CBA6F7" />
                                                    <Setter TargetName="huiText" Property="Text" Value="👁 专注" />
                                                    <Setter TargetName="huiText" Property="Foreground" Value="#1E1E2E" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="huiBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="3"
                                x:Name="CloseButton"
                                Width="36"
                                Height="28"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Click="CloseButton_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBorder"
                                            Background="#45475A"
                                            CornerRadius="6">
                                        <TextBlock Text="✕"
                                                   Foreground="#CDD6F4"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBorder" Property="Background" Value="#F38BA8" />
                                            <Setter TargetName="closeBorder" Property="TextElement.Foreground" Value="#1E1E2E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 中间内容区域 -->
                <Border x:Name="ContentBorder"
                        Grid.Row="1"
                        Background="#313244"
                        CornerRadius="6"
                        Margin="0,5"
                        Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 编辑模式：文本输入 -->
                        <TextBox x:Name="MarkdownEditor"
                                 Grid.Row="0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="#313244"
                                 Foreground="#CDD6F4"
                                 CaretBrush="#CDD6F4"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI, Microsoft YaHei, sans-serif"
                                 FontSize="14"
                                 TextChanged="MarkdownEditor_TextChanged"
                                 Visibility="Visible">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Background" Value="#45475A" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- 预览模式：Markdown 渲染 -->
                        <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                                   Grid.Row="0"
                                                   Background="#313244"
                                                   BorderThickness="0"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Disabled"
                                                   Visibility="Collapsed"
                                                   IsToolBarVisible="False" />

                        <!-- 底部状态栏 -->
                        <Border x:Name="StatusBarBorder"
                                Grid.Row="1"
                                MinHeight="26"
                                Background="#45475A"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,4,0,0">
                            <Grid>
                                <TextBlock x:Name="StatusText"
                                           Text="点击穿透：已关闭"
                                           Foreground="#A6ADC8"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <TextBlock x:Name="MdStatusText"
                                           Text="编辑模式"
                                           Foreground="#89B4FA"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
